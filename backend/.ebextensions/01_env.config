# ============================================================
# Cloud Lib — Elastic Beanstalk: Node.js Platform Config
# Place this in: .ebextensions/01_env.config
# ============================================================

option_settings:
  # ── Node.js Platform ──────────────────────────────────────
  aws:elasticbeanstalk:container:nodejs:
    # Command Elastic Beanstalk uses to start the app
    NodeCommand: "node server.js"
    # Node.js version (matches your Dockerfile)
    NodeVersion: 20

  # ── Environment Variables (non-secret) ────────────────────
  # Secrets (DB_PASSWORD, JWT_SECRET) should be stored in
  # AWS Secrets Manager and injected via the EB console
  # or with the aws:elasticbeanstalk:application:environment namespace.
  aws:elasticbeanstalk:application:environment:
    PORT: "5000"
    NODE_ENV: "production"
    DB_PORT: "3306"
    DB_NAME: "cloud_lib"
    AWS_REGION: "ap-southeast-1"
    # IMPORTANT: Set these in the EB Console under Configuration > Software:
    #   DB_HOST       → your RDS endpoint
    #   DB_USER       → your RDS username
    #   DB_PASSWORD   → your RDS password
    #   JWT_SECRET    → a long random secret (min 32 chars)
    #   FRONTEND_URL  → your CloudFront HTTPS URL
    #   SNS_TOPIC_ARN → your SNS topic ARN

  # ── Load Balancer ─────────────────────────────────────────
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application

  # ── EC2 Instance Type ─────────────────────────────────────
  aws:autoscaling:launchconfiguration:
    # t3.small is cost-effective for a university project
    InstanceType: t3.small

  # ── Auto Scaling ──────────────────────────────────────────
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 3

  # ── Health Check ──────────────────────────────────────────
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

  # ── Rolling Deployments (zero-downtime) ───────────────────
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: "50"
    HealthCheckSuccessThreshold: Ok

  # ── Enhanced Monitoring ───────────────────────────────────
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # ── Log Streaming to CloudWatch ───────────────────────────
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 30
