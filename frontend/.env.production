# ============================================================
# Cloud Lib Frontend — Production Environment Variables
# Used by Vite during `npm run build` for the production bundle
#
# IMPORTANT: Replace the placeholder values below with your
# actual AWS resource URLs after running `aws/setup.sh`
# ============================================================

# The public URL of your Elastic Beanstalk environment.
# CloudFront will proxy /api requests to this URL.
# Example: http://cloudlib-env.eba-xxxxxxxx.ap-southeast-1.elasticbeanstalk.com
VITE_API_BASE_URL=http://your-eb-environment.ap-southeast-1.elasticbeanstalk.com
