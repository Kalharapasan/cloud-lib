# ============================================================
# Cloud Lib Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000

# MySQL Database (Amazon RDS or Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cloud_lib

# JWT Secret
JWT_SECRET=cloudlib_super_secret_key_change_in_production

# AWS SNS (for production — simulated locally)
AWS_REGION=ap-southeast-1
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789:CloudLibOverdueAlerts

# CORS
FRONTEND_URL=http://localhost:5173
