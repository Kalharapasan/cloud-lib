# ============================================================
# Cloud Lib Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000

# MySQL Database (Amazon RDS or Local)
DB_HOST=cloud-lib-db.cv7jjsf4tbv9.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=CloudLib2024!
DB_NAME=mysql

# JWT Secret
JWT_SECRET=cloudlib_super_secret_key_change_in_production

# AWS SNS & S3 Credentials (optional for local testing with real AWS resources)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789:CloudLibOverdueAlerts
S3_BUCKET_COVERS=your-covers-bucket-name

# CORS
FRONTEND_URL=http://localhost:5173
